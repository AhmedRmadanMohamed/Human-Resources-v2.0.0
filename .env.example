# MySQL container settings
MYSQL_DATABASE=hr
MYSQL_USER=hr_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Application datasource settings
DB_URL=jdbc:mysql://localhost:3306/hr?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=hr_app
DB_PASSWORD=replace-with-a-strong-database-password

# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=replace-with-a-base64-encoded-32-byte-secret
JWT_ISSUER=human-resources-api
JWT_TTL=PT1H

# Browser clients allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional first administrator; remove after the account is created
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
